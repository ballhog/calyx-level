(version 1)
# Calyx-Level carrier design rules. Board-level minimums (JLCPCB 2-layer) come from the project's Board Setup.
(rule "within_footprint"
  (constraint clearance (min 0.127mm))
  (condition "A.Parent == B.Parent")
)
# The Pump net class carries 0.3 mm clearance (in the .kicad_pro), so Freerouting honours it too.
